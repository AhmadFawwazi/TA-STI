@article{rahayuInovasiMetodePembelajaran2024,
  title = {{Inovasi Metode Pembelajaran Kolaboratif di Era digital: Studi Kasus Perguruan Tinggi Swasta Magetan: Innovation of Collaborative Learning Methods in the Digital Era: Case Study of Magetan Private Colleges}},
