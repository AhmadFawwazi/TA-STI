@article{forouzandehComprehensiveSurveyModern,
  title = {A Comprehensive Survey of Modern Recommendation Systems: Methods, Personalisation and Scalable Deployment},
  author = {Forouzandeh, Saman and Krivitsky, Pavel N and Chandra, Rohitash},
  abstract = {Recommender systems have emerged as crucial in modern decision support systems that employ diverse machine learning models to capture user preferences to generate personalised recommendations. In the last decade, recommender systems have modernised with innovative deep learning models to be applicable to large-scale applications and diverse settings, including multi-criteria recommender systems. In this paper, we present a comprehensive survey of recommender systems, categorising them based on a novel taxonomy that includes fundamental, emerging, personalisation and interaction, and scalability-focused methods. For each category, we examine the fundamental learning objectives, loss function formulations, and optimisation strategies. Our survey particularly focuses on how different loss functions shape the learning behaviour and performance of these systems. We investigate how modern recommender systems handle various challenges, including sparsity, cold-start problems, fairness, and scalability, through specialised loss function designs. Additionally, we explore recent advances in self-supervised, multimodal fusion, and multi-task learning frameworks that have significantly enhanced recommendation performance. Finally, we identify open challenges and future research directions, particularly in efficient knowledge distillation, explainability, and ethical considerations in recommender systems.},
  langid = {english},
  file = {C:\Users\asus\Zotero\storage\64MAZTCZ\Forouzandeh et al. - A comprehensive survey of modern recommendation systems methods, personalisation and scalable deplo.pdf}
}

